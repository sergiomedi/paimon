# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Nested settings use a double underscore: PAIMON_DATABASE__HOST maps to
# settings.database.host. Unknown PAIMON_ variables abort startup, so a typo
# here stops the process instead of silently leaving a default in place.

PAIMON_ENVIRONMENT=local
PAIMON_DEBUG=true

# --- PostgreSQL -------------------------------------------------------------
PAIMON_DATABASE__HOST=localhost
PAIMON_DATABASE__PORT=5432
PAIMON_DATABASE__USER=paimon
# Matches docker/compose.yaml's default, so a fresh clone works unedited. A
# deployed environment supplies its own and the startup guard refuses this one.
PAIMON_DATABASE__PASSWORD=paimon
PAIMON_DATABASE__NAME=paimon
# Connections for HTTP handlers, burst capacity, and the separate pool reserved
# for agent runs. Keep (pool_size + max_overflow + agent_pool_size) x processes
# below the server's max_connections.
PAIMON_DATABASE__POOL_SIZE=10
PAIMON_DATABASE__MAX_OVERFLOW=5
PAIMON_DATABASE__AGENT_POOL_SIZE=5
# Echoes SQL with bound parameters. Local only; rejected in deployed environments.
PAIMON_DATABASE__ECHO_SQL=false

# --- Redis ------------------------------------------------------------------
PAIMON_REDIS__HOST=localhost
PAIMON_REDIS__PORT=6379
PAIMON_REDIS__DB=0

# --- Identity (ADR-0004) ----------------------------------------------------
# 'dev' signs tokens locally and is refused outside local and test environments.
PAIMON_AUTH__PROVIDER=dev
# At least 32 bytes (RFC 7518 section 3.2); generate with: openssl rand -hex 32
PAIMON_AUTH__DEV_SIGNING_KEY=local-development-only-not-a-real-secret-value
# Required when provider is 'entra':
# PAIMON_AUTH__PROVIDER=entra
# PAIMON_AUTH__TENANT_ID=00000000-0000-0000-0000-000000000000
# PAIMON_AUTH__AUDIENCE=api://paimon

# --- Embeddings (ADR-0011) --------------------------------------------------
# 'local' calls any endpoint speaking the OpenAI embeddings API. For a local model:
#   ollama serve && ollama pull bge-m3
# 'azure' ignores base_url/model and uses the deployment named below.
PAIMON_EMBEDDING__PROVIDER=local
PAIMON_EMBEDDING__BASE_URL=http://localhost:11434/v1
PAIMON_EMBEDDING__MODEL=bge-m3
# Fixed platform-wide: pgvector indexes vector columns with HNSW only up to 2000
# dimensions, and the index was built at this width. Changing it requires a
# migration and a full reindex.
PAIMON_EMBEDDING__DIMENSIONS=1024
# Asymmetric models want an instruction on the query side only, for example
# BGE's "Represent this sentence for searching relevant passages: ".
# PAIMON_EMBEDDING__QUERY_PREFIX=
# PAIMON_EMBEDDING__DOCUMENT_PREFIX=
# PAIMON_EMBEDDING__API_KEY=

# --- Generation -------------------------------------------------------------
PAIMON_CHAT__PROVIDER=local
PAIMON_CHAT__BASE_URL=http://localhost:11434/v1
PAIMON_CHAT__MODEL=qwen2.5:7b-instruct
# Zero by default: a grounded answer should be the same answer for the same
# sources, and an evaluation over a sampled model measures the sampler too.
PAIMON_CHAT__TEMPERATURE=0.0
PAIMON_CHAT__MAX_OUTPUT_TOKENS=1024
# PAIMON_CHAT__API_KEY=

# --- Chunking and retrieval -------------------------------------------------
PAIMON_INGESTION__MAX_CHUNK_TOKENS=512
PAIMON_INGESTION__CHUNK_OVERLAP_TOKENS=64
PAIMON_INGESTION__MIN_CHUNK_TOKENS=16
# Hits returned to the caller, and hits gathered from each retriever before
# fusion. The second is larger on purpose: a chunk ranked eighth by one
# retriever and unseen by the other can still finish first once fused.
# Where vectors live. 'pgvector' needs nothing beyond the database above;
# 'azure_search' needs the Azure AI Search block further down.
PAIMON_RETRIEVAL__STORE=pgvector
PAIMON_RETRIEVAL__TOP_K=8
PAIMON_RETRIEVAL__CANDIDATES_PER_RETRIEVER=40
# The RRF constant. 60 is what Azure AI Search uses, so both backends order
# comparably (ADR-0012).
PAIMON_RETRIEVAL__RRF_K=60
PAIMON_RETRIEVAL__MAX_CONTEXT_TOKENS=6000

# --- Agents (ADR-0016, ADR-0017) --------------------------------------------
# Most nodes one run may execute, which is what stops a routing mistake from
# becoming an unbounded bill.
PAIMON_AGENTS__STEP_LIMIT=25
# Resumable runs keep the graph's own state in PostgreSQL through a second
# driver (psycopg, alongside asyncpg). Off by default: a deployment that never
# suspends a run should not pay for a second connection pool.
PAIMON_AGENTS__RESUMABLE=false
# Suspend a postmortem for a person to accept or correct it before it is
# finalised. Requires PAIMON_AGENTS__RESUMABLE=true.
PAIMON_AGENTS__REVIEW_POSTMORTEMS=false

# --- MCP (ADR-0020) ---------------------------------------------------------
# Paimon as a Model Context Protocol server, mounted inside this API.
PAIMON_MCP__ENABLED=true
PAIMON_MCP__PATH=/mcp
# Host header values the MCP endpoint answers to. Anything else is refused,
# which is protection against DNS rebinding: a page can be made to resolve an
# attacker's hostname to 127.0.0.1 and talk to a local server, and the Host
# header is what gives that away. A deployment behind a proxy lists its own
# names here; an empty list is refused at startup rather than allowing all.
PAIMON_MCP__ALLOWED_HOSTS=["localhost","127.0.0.1","localhost:8000","127.0.0.1:8000"]
# Browser origins permitted to reach it. Empty: this is an API for programs.
PAIMON_MCP__ALLOWED_ORIGINS=[]
# Setting both of these turns the endpoint into an OAuth 2.1 resource server
# (ADR-0021): it publishes RFC 9728 metadata at
# /.well-known/oauth-protected-resource<path> and answers an anonymous caller
# with a 401 that says where to get a token. The resource URL must be the
# address clients actually reach — behind a proxy, the public one — because it
# is also the audience their tokens will name.
# PAIMON_MCP__RESOURCE_URL=https://paimon.example.com/mcp
# PAIMON_MCP__AUTHORIZATION_SERVER=https://login.microsoftonline.com/<tenant>/v2.0

# --- Azure (ADR-0014) -------------------------------------------------------
# Only read when a provider above is set to 'azure' / 'azure_search'. Startup
# fails if a provider is selected and its endpoint or deployment is missing, so
# a half-configured deployment never reaches the first request.
#
# Authentication is chosen by absence: leave the API key unset and the adapter
# acquires a token from Entra ID via DefaultAzureCredential (az login locally,
# a managed identity in Azure) — which is the mode to prefer, because the
# platform then stores no secret at all. See docs/azure-setup.md.

# PAIMON_EMBEDDING__PROVIDER=azure
# PAIMON_CHAT__PROVIDER=azure
# PAIMON_AZURE_OPENAI__ENDPOINT=https://<resource>.openai.azure.com
# Deployment names, not model names: Azure puts the deployment name in the URL
# and it cannot be inferred from the model.
# PAIMON_AZURE_OPENAI__EMBEDDING_DEPLOYMENT=text-embedding-3-large
# PAIMON_AZURE_OPENAI__CHAT_DEPLOYMENT=gpt-4o-mini
# Pinned, not left to the service: a version change alters response shapes.
# PAIMON_AZURE_OPENAI__API_VERSION=2024-10-21
# PAIMON_AZURE_OPENAI__API_KEY=

# PAIMON_RETRIEVAL__STORE=azure_search
# PAIMON_AZURE_SEARCH__ENDPOINT=https://<service>.search.windows.net
# PAIMON_AZURE_SEARCH__INDEX_NAME=paimon-chunks
# PAIMON_AZURE_SEARCH__API_VERSION=2024-07-01
# Semantic ranking has no pgvector equivalent, so it stays off unless a
# configuration of this name exists on the index — the difference between the
# two backends should be visible, not smoothed over.
# PAIMON_AZURE_SEARCH__SEMANTIC_CONFIGURATION=
# PAIMON_AZURE_SEARCH__API_KEY=


# --- External document sources (ADR-0023) -----------------------------------
# Paimon is an MCP client here, not a server. It reads documentation out of
# systems it does not own and indexes it like any other document.
#
# The endpoint is the READ-ONLY repository toolset of GitHub's official server.
# Scoping at the tool level rather than the server level is deliberate: a
# synchronisation that cannot call delete_file cannot be talked into calling it,
# whatever ends up in a README.
# PAIMON_SOURCES__GITHUB_ENDPOINT=https://api.githubcopilot.com/mcp/x/repos/readonly
# A GitHub token with read access to the repositories listed below. Nothing else.
# PAIMON_SOURCES__GITHUB_TOKEN=
#
# Sources are a registry, never a request parameter. The API lets a caller name
# one of these; it does not let them supply a URL, a repository or a credential.
# That is the whole difference between an integration and an SSRF gadget.
#
# As JSON, because the list is structured. 'paths' matters more than it looks:
# left empty the walk starts at the repository root, which on a repository that
# also holds code is a long and expensive way to index nothing useful.
# PAIMON_SOURCES__GITHUB=[{"name":"handbook","owner":"acme","repo":"handbook","paths":["docs"],"suffixes":[".md"],"max_depth":4,"max_documents":200}]
#
# Fingerprints of the server's tool definitions, recorded once they have been
# reviewed. Tool descriptions are what a model reads, and a server can change
# them between one session and the next; pinned here, a change stops the
# synchronisation instead of passing unreviewed text along. The first connection
# logs the digest to paste in ("mcp_tool_unpinned").
# ..."pinned_tools":{"get_file_contents":"<sha256>"}
#
# Local development only, and refused outside it: this switches off the guard
# that stops a client running inside a server from being pointed at private
# addresses — including the cloud metadata endpoint that hands out credentials.
# PAIMON_SOURCES__ALLOW_LOOPBACK_ENDPOINTS=false

# --- Observability ----------------------------------------------------------
PAIMON_OBSERVABILITY__SERVICE_NAME=paimon-api
PAIMON_OBSERVABILITY__LOG_LEVEL=INFO
# 'console' is readable for humans; 'json' is what deployments emit.
PAIMON_OBSERVABILITY__LOG_FORMAT=console

# --- Tracing (ADR-0025) -----------------------------------------------------
# Plain OpenTelemetry, exported over OTLP. The backend is a destination, not a
# dependency: Langfuse, Azure Monitor and a collector in front of either are all
# this endpoint with different credentials. There is no vendor SDK in the code.
#
# Off by default. A deployment with nowhere to send traces pays nothing for them,
# and enabling this without an endpoint is refused at startup rather than
# collecting into a void that looks identical to tracing that works.
# PAIMON_OBSERVABILITY__TRACING__ENABLED=false
# PAIMON_OBSERVABILITY__TRACING__ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# Credentials for the backend. Langfuse wants HTTP basic auth, built from its
# public and secret keys:
#   printf '%s' "pk-lf-...:sk-lf-..." | base64
# PAIMON_OBSERVABILITY__TRACING__HEADERS='{"Authorization":"Basic <base64>"}'
#
# Head-based sampling: the decision is made once at the root of a trace and
# inherited, so a kept trace is complete rather than full of holes. 1.0 keeps
# everything, which is right until the volume says otherwise.
# PAIMON_OBSERVABILITY__TRACING__SAMPLE_RATIO=1.0
# A collector that stops answering must not become this platform's outage.
# PAIMON_OBSERVABILITY__TRACING__EXPORT_TIMEOUT_SECONDS=10
#
# Record prompts and completions on spans. The semantic conventions mark message
# content opt-in and warn it is likely to contain sensitive data — here it is an
# organization's documentation and whatever its people typed. Refused outright in
# staging and production: turning it on where real tenants' material flows should
# cost a code change and a review, not an environment variable.
# PAIMON_OBSERVABILITY__TRACING__CAPTURE_CONTENT=false

# --- Metrics and cost (ADR-0028) --------------------------------------------
# A SEPARATE endpoint from tracing, and this is the trap: several tracing
# backends — Langfuse among them — accept OTLP traces and nothing else. Metrics
# pointed at a traces endpoint fail quietly, and the symptom is an empty
# dashboard that looks like a platform emitting nothing. Metrics usually want a
# collector, or a backend that takes them.
# PAIMON_OBSERVABILITY__METRICS__ENABLED=false
# PAIMON_OBSERVABILITY__METRICS__ENDPOINT=http://localhost:4318/v1/metrics
# PAIMON_OBSERVABILITY__METRICS__HEADERS='{"Authorization":"Bearer <token>"}'
# PAIMON_OBSERVABILITY__METRICS__EXPORT_INTERVAL_SECONDS=60
#
# Cost is not measured and is not in the conventions: it is token counts times a
# table somebody typed, and the provider's invoice is the authority. What this
# buys is the shape of a bill before it arrives — which tenant, which model,
# which day.
#
# Prices are per MILLION tokens, because that is the unit providers publish;
# converting here is where a factor of a thousand goes unnoticed. A model absent
# from the table produces no cost figure rather than a zero.
#
# 'revision' is required once there are prices, and it travels with every
# measurement: a cost figure that cannot be traced back to the prices that
# produced it is uninterpretable the moment the table changes — and it changes.
# PAIMON_OBSERVABILITY__METRICS__PRICING__CURRENCY=USD
# PAIMON_OBSERVABILITY__METRICS__PRICING__REVISION=2026-09-01
# PAIMON_OBSERVABILITY__METRICS__PRICING__MODELS='{"gpt-4o-mini":{"input":0.15,"output":0.60}}'
